{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ifikraDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "Issuer": "ifikra.IAM",
    "Audience": "ifikra.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_EMAIL",
    "Password": "YOUR_EMAIL_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL",
    "FromName": "ifikra Support",
    "EnableSsl": true
  },
  "FrontendSettings": {
    "BaseUrl": "https://localhost:4200",
    "EmailVerificationPath": "/verify-email",
    "PasswordResetPath": "/reset-password"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  },
  "Facebook": {
    "AppId": "YOUR_FACEBOOK_APP_ID",
    "AppSecret": "YOUR_FACEBOOK_APP_SECRET"
  },
  "LinkedInSettings": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "https://localhost:PORT/signin-linkedin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "GitHub": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "RedirectUri": "https://localhost:YOUR_API_PORT/api/auth/github-callback"
    },
    "Microsoft": {
      "ClientId": "YOUR_MICROSOFT_CLIENT_ID",
      "TenantId": "common",
      "RedirectUri": "https://localhost:YOUR_API_PORT/api/auth/microsoft-callback"
    },
    "X": {
      "ClientId": "YOUR_X_CLIENT_ID",
      "RedirectUri": "https://localhost:YOUR_API_PORT/api/auth/x-callback"
    },

  "AllowedHosts": "*"
}
